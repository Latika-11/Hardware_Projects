def log_plate(text, conf, img_path):
    state = text[:2]; dist = text[2:4]; ser = text[4:-4]; num = text[-4:]
    fmt = f"{state}-{dist}-{ser}-{num}"
    with open(CSV_LOG, 'a', newline='') as f:
        csv.writer(f).writerow([
            datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            text, f"{conf:.2f}", fmt, img_path
        ])

