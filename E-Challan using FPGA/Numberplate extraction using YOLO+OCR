#  MAIN LOOP
# ══════════════════════════════════════════════════════════
cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)

frame_idx = 0
confirmed = []
saved_count = 0

print("[INFO] Starting Smart Traffic System...")
print("Format: AA-99-AA-9999 (Indian plates only)")

while True:
    ret, frame = cap.read()
    if not ret: break
    
    frame = cv2.resize(frame, (1280, 720))
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    frame_idx += 1

    # YOLO HELMET DETECTION
    helmet_violation = detect_helmet(frame)

    # Collect OCR results (FIXED LINE 114+)
    raw_detections = []
    try:
        while not ocr_out.empty():
            batch = ocr_out.get_nowait()
            for bbox, text, conf, color_roi in batch:
                raw_detections.append((bbox, text, conf))
                if tracker.needs_save(text):
                    save_plate_image(text, color_roi, conf)
                    tracker.mark_saved(text)
                    saved_count += 1
                    # Send to FPGA with violation status
                    violation = "H" if helmet_violation else "R"
                    send_to_fpga(text, violation)
    except:
        pass

    confirmed = tracker.update(raw_detections)

    # Dispatch OCR
    if frame_idx % DETECT_EVERY == 0 and ocr_in.empty():
        candidates = extract_candidates(gray)
        if candidates:
            batch = []
            for (x,y,w,h) in candidates:
                gray_roi = gray[y:y+h, x:x+w]
                color_roi = frame[y:y+h, x:x+w].copy()
                if gray_roi.size > 0:
                    batch.append(((x,y,w,h), gray_roi, color_roi))
            if batch:
                try:
                    ocr_in.put_nowait(batch)
                except:
                    pass

    # Draw everything
    for bbox, text, conf, hits in confirmed:
        draw_plate_box(frame, bbox, text, conf, hits)
    draw_hud(frame, confirmed, saved_count, helmet_violation)

    cv2.imshow("🚦 SMART TRAFFIC SYSTEM 🚦", frame)
    
    key = cv2.waitKey(1) & 0xFF
    if key == ord('q'): break

ocr_in.put(None)
cap.release()
cv2.destroyAllWindows()
if SERIAL_ON: ser.close()
print(f"\n[DONE] Plates saved: {saved_count}")
