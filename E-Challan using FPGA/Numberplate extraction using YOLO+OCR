#  PLATE TRACKER
# ══════════════════════════════════════════════════════════
class PlateTracker:
    def __init__(self):
        self.plates = {}
        self.saved = set()

    def update(self, detections):
        seen = set()
        for bbox, text, conf in detections:
            seen.add(text)
            if text in self.plates:
                e = self.plates[text]
                e['hits'] += 1
                e['misses'] = 0
                e['bbox'] = bbox
                e['conf'] = max(e['conf'], conf)
            else:
                self.plates[text] = dict(hits=1, misses=0, bbox=bbox, conf=conf)

        for text in list(self.plates):
            if text not in seen:
                self.plates[text]['misses'] += 1
                if self.plates[text]['misses'] > MAX_MISSES:
                    del self.plates[text]

        return [(v['bbox'], k, v['conf'], v['hits']) 
                for k, v in self.plates.items() 
                if v['hits'] >= MIN_HITS and v['conf'] >= SAVE_CONF]

    def needs_save(self, text):
        return text not in self.saved

    def mark_saved(self, text):
        self.saved.add(text)

tracker = PlateTracker()

