VALID_STATE_CODES = {
    'AN','AP','AR','AS','BR','CH','CG','DD','DL','DN',
    'GA','GJ','HR','HP','JH','JK','KA','KL','LA','LD',
    'MH','ML','MN','MP','MZ','NL','OD','PB','PY','RJ',
    'SK','TN','TS','TR','UK','UP','WB'
}

DIGIT_TO_LETTER = {'0':'O','1':'I','2':'Z','5':'S','6':'G','8':'B'}
LETTER_TO_DIGIT = {'O':'0','I':'1','Z':'2','S':'5','G':'6','B':'8','D':'0'}

