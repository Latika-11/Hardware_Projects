def correct_plate(raw: str) -> str | None:
    s = ''.join(filter(str.isalnum, raw.upper()))
    if len(s) < 8 or len(s) > 10:
        return None

    for length in [10, 9, 8]:
        for start in range(len(s) - length + 1):
            chunk = s[start:start+length]
            corrected = force_format(chunk)
            if corrected:
                return corrected
    return None

def force_format(s: str) -> str | None:
    n = len(s)
    if n not in (8, 9, 10):
        return None

    chars = list(s)
    
    # 0,1 → LETTERS (state)
    for i in (0, 1):
        if chars[i].isdigit():
            chars[i] = DIGIT_TO_LETTER.get(chars[i], chars[i])
        if not chars[i].isalpha():
            return None

    # 2,3 → DIGITS (district)
    for i in (2, 3):
        if chars[i].isalpha():
            chars[i] = LETTER_TO_DIGIT.get(chars[i], chars[i])
        if not chars[i].isdigit():
            return None

    # Last 4 → DIGITS (number)
    for i in range(n-4, n):
        if chars[i].isalpha():
            chars[i] = LETTER_TO_DIGIT.get(chars[i], chars[i])
        if not chars[i].isdigit():
            return None

    # Middle → LETTERS (series)
    for i in range(4, n-4):
        if chars[i].isdigit():
            chars[i] = DIGIT_TO_LETTER.get(chars[i], chars[i])
        if not chars[i].isalpha():
            return None

    result = ''.join(chars)
    if not INDIAN_PLATE_RE.match(result):
        return None

    state = result[:2]
    if state not in VALID_STATE_CODES:
        return None

    return result

